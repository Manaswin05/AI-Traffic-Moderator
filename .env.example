# ==================================
# AI Traffic Moderator - Environment Variables
# ==================================

# Python Configuration
PYTHON_VERSION=3.11.0

# Node.js Configuration
NODE_VERSION=18.17.0

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False
PORT=5000

# YOLO Model Configuration
# Model will auto-download if not present
YOLO_MODEL_PATH=models/yolov8n.pt

# K-Means Configuration (Optional - uses defaults if not set)
KMEANS_MIN_SAMPLES=20
KMEANS_RETRAIN_INTERVAL=150
KMEANS_MAX_DATA_SIZE=200

# Logging Configuration
LOG_LEVEL=INFO
PYTHONUNBUFFERED=1

# CORS Configuration (Optional)
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ==================================
# Development Only (Not for Production)
# ==================================

# Vite Dev Server Port (Local development only)
# VITE_PORT=5173

# Enable debug mode (Local development only)
# FLASK_DEBUG=True
# Render.com Environment Variables for 512MB RAM optimization
# Copy these to your Render dashboard Environment Variables section

# Python Memory Optimization
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
MALLOC_TRIM_THRESHOLD_=100000

# PyTorch CPU-only mode
CUDA_VISIBLE_DEVICES=-1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1

# Video source (use placeholder or small demo video)
VIDEO_SOURCE=demo_traffic.mp4

# Gunicorn worker configuration
WEB_CONCURRENCY=1
WORKERS=1
THREADS=1
WORKER_CLASS=sync
MAX_REQUESTS=100
MAX_REQUESTS_JITTER=10

# Flask configuration
FLASK_ENV=production
FLASK_DEBUG=0
